<Window x:Class="Sakir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şakir" Height="600" Width="780"
        Background="#0E1017" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#F2F4F8" />
        <SolidColorBrush x:Key="Muted" Color="#8A90A2" />
        <SolidColorBrush x:Key="Accent" Color="#FF3C5A" />
        <SolidColorBrush x:Key="Card" Color="#171A25" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232735" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- live preview of exactly what the pump head is showing -->
        <StackPanel Grid.Column="0" Width="384">
            <TextBlock Text="PANEL" Style="{StaticResource Label}" Margin="0,0,0,6" />
            <Border Background="Black" CornerRadius="6" Padding="4"
                    BorderBrush="#2A2F40" BorderThickness="1">
                <!-- Uniform, not Fill: the frame is 320x240 or, on a tall mount,
                     240x320. Fill stretched the portrait frame into this wide
                     box and squashed the gauges into ovals. -->
                <Image x:Name="Preview" Width="368" Height="276" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock x:Name="DeviceText" Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBlock x:Name="StatsText" Foreground="{StaticResource Muted}" FontSize="11" />
        </StackPanel>

        <!-- scrolls so the Support section can never be clipped off the bottom -->
        <ScrollViewer Grid.Column="1" Margin="24,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Şakir" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="CoreLiquid LCD, without MSI Center's limits"
                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />

            <TextBlock Text="SCENE" Style="{StaticResource Label}" />
            <RadioButton x:Name="ModeAuto" Content="Auto  -  game, then music, then dashboard"
                         GroupName="mode" IsChecked="True" Checked="Mode_Checked" Tag="auto" />
            <RadioButton x:Name="ModeDash" Content="Dashboard" GroupName="mode" Checked="Mode_Checked" Tag="dashboard" />
            <RadioButton x:Name="ModeMusic" Content="Now playing" GroupName="mode" Checked="Mode_Checked" Tag="nowplaying" />
            <RadioButton x:Name="ModeGame" Content="Game" GroupName="mode" Checked="Mode_Checked" Tag="game" />
            <RadioButton x:Name="ModeMirror" Content="Screen mirror" GroupName="mode" Checked="Mode_Checked" Tag="mirror" />

            <!-- window picker: capturing a window directly means it does not
                 have to stay visible on screen -->
            <Grid Margin="22,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- explicit colours: the default ComboBox chrome is unreadable
                     against this dark window -->
                <ComboBox x:Name="MirrorSource" Grid.Column="0" Height="24"
                          Background="#232735" Foreground="#F2F4F8" BorderBrush="#3A4055"
                          DropDownOpened="MirrorSource_DropDownOpened"
                          SelectionChanged="MirrorSource_SelectionChanged">
                    <!-- Setting Background only colours the closed box. The
                         dropdown popup is drawn by the default template using
                         the system window brush, so override that brush inside
                         this control's own resource scope. -->
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1F2C" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F4F8" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3C5A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                    </ComboBox.Resources>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#1B1F2C" />
                            <Setter Property="Foreground" Value="#F2F4F8" />
                            <Setter Property="Padding" Value="6,3" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="1" Content="Refresh" Margin="6,0,0,0"
                        Padding="8,2" Click="RefreshWindows_Click" />
            </Grid>

            <TextBlock x:Name="FpsLabel" Text="FRAME RATE" Style="{StaticResource Label}" />
            <Slider x:Name="FpsSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="Fps_Changed" />

            <TextBlock x:Name="BrightLabel" Text="BRIGHTNESS" Style="{StaticResource Label}" />
            <Slider x:Name="BrightSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="10"
                    IsSnapToTickEnabled="True" ValueChanged="Bright_Changed" />

            <TextBlock x:Name="ScaleLabel" Text="TEXT SIZE" Style="{StaticResource Label}" />
            <Slider x:Name="ScaleSlider" Minimum="1.0" Maximum="1.4" Value="1.15"
                    TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Scale_Changed" />

            <TextBlock Text="STARTUP" Style="{StaticResource Label}" />
            <CheckBox x:Name="AutoStart" Content="Start with Windows" Click="AutoStart_Click" />

            <WrapPanel Margin="0,18,0,0">
                <Button Content="Backgrounds folder" Click="OpenBackgrounds_Click" Margin="0,0,8,6" />
                <Button Content="Game profiles folder" Click="OpenGames_Click" Margin="0,0,8,6" />
                <Button x:Name="ElevateButton" Content="Restart as administrator"
                        Click="Elevate_Click" Visibility="Collapsed" Margin="0,0,8,6" />
            </WrapPanel>

            <TextBlock x:Name="NoteText" Foreground="{StaticResource Muted}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,14,0,0" />

            <!-- Support: buttons appear only when their URL is configured -->
            <StackPanel x:Name="SupportPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <Border Background="#1B1F2C" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Free and open source. If it earned it, you can chip in."
                                   Foreground="{StaticResource Fg}" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="DonateButton" Content="Donate" Click="Donate_Click"
                                    Background="{StaticResource Accent}" Margin="0,0,8,0"
                                    Visibility="Collapsed" />
                            <Button x:Name="ProjectButton" Content="View on GitHub" Click="Project_Click"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
